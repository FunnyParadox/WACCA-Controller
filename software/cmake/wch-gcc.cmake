set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT WCH_TOOLCHAIN_DIR)
	get_filename_component(WCH_TOOLCHAIN_DIR
		"${CMAKE_CURRENT_LIST_DIR}/../.tools/risc-none-embed-gcc-8.2.0" ABSOLUTE)
endif()
set(_wch_bin "${WCH_TOOLCHAIN_DIR}/bin")
find_program(CMAKE_C_COMPILER riscv-none-embed-gcc PATHS "${_wch_bin}" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
find_program(CMAKE_AR riscv-none-embed-ar PATHS "${_wch_bin}" NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_OBJCOPY riscv-none-embed-objcopy PATHS "${_wch_bin}" NO_DEFAULT_PATH REQUIRED)
find_program(WCH_SIZE riscv-none-embed-size PATHS "${_wch_bin}" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_C_FLAGS_INIT "-march=rv32imac -mabi=ilp32 -msmall-data-limit=8 -mno-save-restore")
set(CMAKE_ASM_FLAGS_INIT "-march=rv32imac -mabi=ilp32 -msmall-data-limit=8 -mno-save-restore")

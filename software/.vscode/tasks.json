{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build MCU firmware",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}/build.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			}
		},
		{
			"label": "Run PC tests",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}/build.ps1",
				"tests"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"problemMatcher": [
				"$gcc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			}
		}
	]
}

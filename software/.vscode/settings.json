{
	"clangd.arguments": [
		"--query-driver=C:/msys64/ucrt64/bin/gcc.exe"
	],
	"cmake.sourceDirectory": "${workspaceFolder}",
	"cmake.buildDirectory": "${workspaceFolder}/build/firmware",
	"cmake.generator": "Ninja",
	"cmake.configureOnOpen": false,
	"cmake.configureSettings": {
		"CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/cmake/wch-gcc.cmake",
		"CMAKE_EXPORT_COMPILE_COMMANDS": true
	},
	"files.exclude": {
		"build": true,
		".tools": true,
		"**/build": true,
		"**/.cache": true
	},
	"search.exclude": {
		"build/**": true,
		".tools/**": true,
		"**/build/**": true,
		"**/.cache/**": true
	},
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	"editor.tabSize": 4,
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"[markdown]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"files.associations": {
		".clangd": "yaml"
	}
}
